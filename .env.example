# Токен сообщества ВКонтакте.
# Где взять: Управление сообществом -> Работа с API -> Ключи доступа -> Создать ключ
# Обязательно включите Long Poll API (Управление -> Работа с API -> Long Poll API)
GROUP_TOKEN=your_group_token_here

# Числовой ID сообщества (без минуса). Узнать: Управление сообществом -> Адрес и название
GROUP_ID=123456789
